# Clave de API de Groq para inferencia del modelo LLM
GROQ_API_KEY=tu_api_key_aqui

# Modelo de Groq utilizado para inferencia (por defecto openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# Entorno de despliegue de LEXIS: produccion | pruebas | desarrollo
# Cuando LEXIS_ENV=pruebas se habilitan los botones Like/Dislike, la calificación
# de 0 a 5 estrellas por respuesta y el formulario de validación por Licenciados en Derecho.
LEXIS_ENV=pruebas

# Clave de administrador para habilitar la exportación de sesiones y evaluaciones en la barra lateral
# Si se deja vacía o no se define, el panel de exportación permanece deshabilitado por seguridad.
LEXIS_ADMIN_KEY=
