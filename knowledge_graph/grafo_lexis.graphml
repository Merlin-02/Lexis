  <data key="d37">misma_ley</data>
  <data key="d38">artículo 628</data>
  <data key="d39">o su representante; pero cualquiera de ellos se sujetará al orden establecido en el artículo 628.</data>
  <data key="d40">artículo 628</data>
  <data key="d41">247</data>
  <data key="d42">259</data>
  <data key="d43">texto_general</data>
